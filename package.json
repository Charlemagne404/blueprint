{
  "name": "blueprint-discord-bot",
  "version": "1.0.1",
  "description": "A modular, dashboard-first Discord bot and control center.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "NODE_ENV=production node src/index.js",
    "test": "node --test --test-force-exit test/*.test.js",
    "backup": "node scripts/backup-sqlite.js",
    "check:production-config": "node scripts/check-production-config.js",
    "check:syntax": "node scripts/check-syntax.js",
    "verify:backup": "node scripts/verify-sqlite-backup.js",
    "verify": "npm run check:syntax && npm test && npm audit --omit=dev --audit-level=high && npm run check:production-config"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@continental/id-client": "https://github.com/Charlemagne404/continental-id-client/archive/d74f02e4c24ffb93e2753e64f414fe16006f5f8e.tar.gz",
    "better-sqlite3": "^12.1.1",
    "discord.js": "^14.19.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-session": "^1.18.1"
  }
}
